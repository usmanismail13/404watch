generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subscription   Subscription?
  supportTickets SupportTicket[]
  websites       Website[]
  payments       Payment[]

  @@index([createdAt])
}

model Website {
  id                Int        @id @default(autoincrement())
  userId            Int
  url               String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  monitoringEnabled Boolean    @default(true)
  errors            Error404[]
  scans             Scan[]
  user              User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Error404 {
  id          Int       @id @default(autoincrement())
  websiteId   Int
  url         String
  sourceUrl   String
  status      String
  detectedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recoveredAt DateTime?
  alertSent   Boolean   @default(false)
  website     Website   @relation(fields: [websiteId], references: [id])

  @@index([websiteId])
  @@index([status])
}

model Scan {
  id          Int       @id @default(autoincrement())
  websiteId   Int
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  website     Website   @relation(fields: [websiteId], references: [id])

  @@index([websiteId])
  @@index([status])
}

model Subscription {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  status         String
  startDate      DateTime
  expirationDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@index([status])
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  userId    Int
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticketId  String   @unique
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Payment {
  id              Int       @id @default(autoincrement())
  userId          Int
  amount          Decimal
  token           String
  network         String
  walletAddress   String
  transactionHash String    @unique
  status          String    @default("pending")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}
